---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialSection from '../components/shared/TestimonialSection.astro';
import TrainingGalleryPdf from '../components/shared/TrainingGalleryPdf.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';

const heroSlides = [
  {
    image: '/media/hero-slide-1.svg',
    alt: 'Sự thật về Xuất khẩu Trái cây Việt Nam & Chuỗi cung ứng ĐBSCL',
  },
  {
    image: '/media/hero-slide-2.svg',
    alt: 'Tuân thủ & Xác thực Tiêu chuẩn FDA, BICON, SPS bằng AI',
  },
  {
    image: '/media/hero-slide-3.svg',
    alt: 'Chiến lược AI Marketing Nông sản & Tối ưu hóa GEO Toàn cầu',
  },
  {
    image: '/media/hero-slide-4.svg',
    alt: 'Phân loại Mã HS & Tuân thủ Thông tư Thuế Hải quan XNK 85/2026/TT-BTC',
  },
];

const expertFaqs = [
  {
    question: "Làm thế nào để ứng dụng AI vào rà soát L/C và hợp đồng ngoại thương mà không lo ngại rò rỉ bí mật thương mại?",
    answer: "MDA áp dụng kiến trúc Middleware Local AI độc lập kết hợp cơ chế Data Masking cục bộ ngay tại máy trạm. Trước khi dữ liệu chứng từ được xử lý qua mô hình ngôn ngữ lớn, toàn bộ thông tin nhạy cảm (tên người mua/bán, đơn giá CIF/FOB, số tài khoản, điều khoản thanh toán riêng) đều được mã hóa hoặc ẩn danh. Hệ thống chỉ đối soát logic tính toán và tính tương thích quy tắc UCP 600, ISBP 821, tuân thủ nghiêm ngặt chuẩn bảo mật doanh nghiệp và GDPR/EU mà không gửi dữ liệu thô lên đám mây công cộng."
  },
  {
    question: "Tại sao doanh nghiệp xuất khẩu trái cây sấy thăng hoa và trái cây tươi thường gặp rủi ro phạt thuế hoặc ách tắc mã HS tại cảng đến?",
    answer: "Theo quy định tại Thông tư 85/2026/TT-BTC và chuẩn phân loại hải quan thế giới (WCO), trái cây tươi (thuộc Chương 08) và trái cây qua xử lý nhiệt hoặc sấy thăng hoa (thuộc Chương 20) chịu sự điều chỉnh của hai khung thuế suất, tiêu chuẩn kỹ thuật và kiểm dịch SPS hoàn toàn khác nhau. Một sai lệch nhỏ ở 2 chữ số phân nhóm phụ có thể khiến lô hàng bị tạm giữ, kiểm tra thực tế (luồng Đỏ), phạt chậm thông quan và bị cơ quan hải quan truy thu thuế sau thông quan. MDA hướng dẫn doanh nghiệp lập Hồ sơ kỹ thuật quy trình sản xuất và Bảng thẩm định mã HS để giải trình minh bạch."
  },
  {
    question: "Doanh nghiệp của chúng tôi có quy mô vừa và nhỏ (SME), dữ liệu chưa số hóa bài bản thì có thể ứng dụng AI vào quy trình XNK được không?",
    answer: "Hoàn toàn khả thi. MDA thiết kế lộ trình tiếp cận dựa trên 'Độ sẵn sàng dữ liệu' (Data Readiness) thực tế của từng doanh nghiệp. Chúng tôi không yêu cầu doanh nghiệp phải đầu tư hệ thống ERP đắt đỏ hay thay đổi phần mềm đang dùng. Thay vào đó, chuyên gia sẽ hướng dẫn nhân sự chuẩn hóa các biểu mẫu Excel, PDF chứng từ hiện hữu, ứng dụng bộ Prompt Template chuyên ngành ngoại thương và áp dụng phương pháp Human-in-the-Loop (AI gợi ý kiểm tra, con người đối chiếu và phê duyệt cuối cùng), giúp tiết kiệm ngay 60-70% thời gian xử lý sự vụ."
  },
  {
    question: "Chương trình Huấn luyện Thực chiến 1-1 của Ms Jen Phạm khác biệt như thế nào so với các khóa học xuất nhập khẩu đại trà?",
    answer: "Khác biệt cốt lõi nằm ở tính thực chiến và cá nhân hóa tuyệt đối: Không dạy lý thuyết suông trên tình huống mẫu. Ms Jen Phạm trực tiếp ngồi lại cùng bạn để mổ xẻ trên chính bộ chứng từ (Invoice, Packing List, B/L, C/O, Kiểm dịch) của mặt hàng bạn đang kinh doanh. Trọng tâm của khóa học là năng lực Quản lý ngoại lệ (Exception Management): cách ứng biến khi tàu hủy chuyến (Blank Sailing), chứng từ có sai sót (Discrepancy), hãng tàu phát sinh phụ phí bất hợp lý hoặc khách hàng quốc tế khiếu nại chất lượng hàng."
  },
  {
    question: "Quy trình triển khai tư vấn và tích hợp AI cho doanh nghiệp xuất khẩu diễn ra theo các giai đoạn nào?",
    answer: "MDA luôn khởi đầu bằng Giai đoạn Khảo sát & Đánh giá (Discovery Phase) kéo dài 30 ngày. Trong giai đoạn này, chuyên gia MDA sẽ phỏng vấn trực tiếp các bộ phận (Mua hàng, Chứng từ, Logistics, Pháp chế) để lập bản đồ luồng công việc và nhận diện 2–3 'điểm nghẽn' gây lãng phí chi phí nhất. Sau đó, chúng tôi mới đề xuất giải pháp đào tạo In-house hoặc tích hợp Middleware Local AI với chỉ số KPI cam kết cụ thể, đảm bảo doanh nghiệp nhìn thấy hiệu quả hoàn vốn (ROI) rõ ràng trước khi mở rộng quy mô."
  }
];
---

<BaseLayout
  title="Mekong Delta Agri (MDA Hub) | Đào tạo XNK Thực chiến, Tư vấn Pháp lý & Ứng dụng AI Nông sản"
  description="Hệ sinh thái tri thức và đào tạo Xuất Nhập Khẩu nông sản hàng đầu Việt Nam. Huấn luyện thực chiến 1-1 cùng Ms Jen Phạm, tư vấn chứng từ thương mại, mã HS, tuân thủ tiêu chuẩn FDA/BICON/SPS và đào tạo ứng dụng AI chuyên sâu cho doanh nghiệp XNK."
>
  <!-- SECTION 1: HERO & WELCOME TO MDA AGRO KNOWLEDGE HUB -->
  <section class="section section--soft hero-section">
    <div class="container">
      <div class="grid-2 hero-grid">
        <!-- Left Column: Chào Mừng & Định Vị -->
        <div class="hero-left">
          <span class="badge">Cộng đồng TP.HCM về Chứng từ &amp; AI XNK</span>
          <h1 class="section-title hero-title">
            Chào mừng đến với Trung tâm Tri thức Nông sản &amp; XNK MDA
          </h1>
          <p class="lead hero-lead">
            <strong>MDA Hub</strong> là hệ sinh thái tri thức và chứng từ thương mại toàn diện dành cho ngành nông sản Việt Nam. Dưới sự dẫn dắt chuyên môn của <strong>Ms Jen Phạm</strong> và Hội đồng Pháp lý MDA, chúng tôi đơn giản hóa các rào cản pháp lý xuyên biên giới thông qua tư vấn tuân thủ chi tiết (<strong>FDA, BICON, SPS</strong>), phân loại mã HS chính xác và tích hợp AI an toàn cho doanh nghiệp tự chủ chuỗi cung ứng toàn cầu.
          </p>
          <div class="hero-cta-group">
            <a href="https://forms.google.com/" target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
              <i class="bi bi-clipboard2-check"></i> Đăng Ký Tư Vấn Khóa Học
            </a>
            <a href="/dich-vu/" class="btn btn--outline">
              <i class="bi bi-arrow-right-circle"></i> Khám Phá Dịch Vụ
            </a>
          </div>
        </div>

        <!-- Right Column: Slider Hình Ảnh Trực Quan (Chỉ hình ảnh) -->
        <div class="hero-right">
          <div class="hero-slider" id="heroSlider">
            <div class="hero-slides-wrapper" id="heroSlidesTrack">
              {heroSlides.map((slide, index) => (
                <div class={`hero-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                  <div class="hero-slide__image-wrap">
                    <img
                      src={slide.image}
                      alt={slide.alt}
                      width="600"
                      height="380"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                </div>
              ))}
            </div>

            <!-- Slider Dots -->
            <div class="slider-dots" id="sliderDots">
              {heroSlides.map((_, i) => (
                <button
                  type="button"
                  class={`dot-btn ${i === 0 ? 'active' : ''}`}
                  data-slide={i}
                  aria-label={`Chuyển đến hình ảnh ${i + 1}`}
                ></button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: VÌ SAO CHỌN CHÚNG TÔI (Agro-Export Knowledge Style) -->
  <section class="section section--white why-choose-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge">Giá Trị Khác Biệt</span>
        <h2 class="section-title">Vì Sao Chọn Chúng Tôi</h2>
        <p class="lead">
          Mekong Delta Agri (MDA Hub) mang đến bộ giải pháp 3 trụ cột vững chắc, kết hợp giữa nghiệp vụ xuất nhập khẩu nông sản thực chiến và công nghệ AI bảo mật cao cấp dành riêng cho doanh nghiệp Việt Nam.
        </p>
      </div>

      <div class="grid-3 why-choose-grid">
        <!-- Cột 1: Đào tạo ứng dụng quy trình -->
        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-person-workspace"></i> Đào Tạo Ứng Dụng Quy Trình
          </div>
          <h3 class="why-card__title">Đào Tạo Ứng Dụng Quy Trình Thực Tế</h3>
          <p class="why-card__desc">
            Chương trình huấn luyện may đo theo đặc thù mặt hàng (trái cây tươi, sấy thăng hoa, nông sản ĐBSCL) và năng lực thực tế của doanh nghiệp. Học viên trực tiếp mổ xẻ chứng từ sống, rèn luyện kỹ năng Quản lý ngoại lệ (Exception Management) và tháo gỡ điểm nghẽn thực chiến cùng Ms Jen Phạm.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> May đo 1-1 trên hợp đồng &amp; hồ sơ thật của doanh nghiệp</li>
            <li><i class="bi bi-check-circle-fill"></i> Kỹ năng xử lý ngoại lệ: trễ tàu, sai khác B/L, luồng Đỏ</li>
            <li><i class="bi bi-check-circle-fill"></i> Đồng bộ quy trình liên phòng ban Kinh doanh &amp; Logistics</li>
          </ul>
          <a href="/dich-vu/dao-tao-xnk-thuc-chien-1-1/" class="why-card__link">
            Tìm hiểu khóa đào tạo 1-1 <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <!-- Cột 2: Tích hợp AI Business Integration -->
        <div class="why-card why-card--highlight">
          <div class="why-card__badge">
            <i class="bi bi-cpu-fill"></i> AI Business Integration
          </div>
          <h3 class="why-card__title">Tích Hợp AI Business Vào Quy Trình XNK</h3>
          <p class="why-card__desc">
            Giải pháp Middleware Local AI độc lập, bảo mật dữ liệu cục bộ theo chuẩn GDPR/EU với công nghệ Data Masking. Tự động hóa rà soát Hợp đồng ngoại thương, đối soát chứng từ và kiểm tra sự phù hợp điều khoản UCP 600 trong 60 giây mà không cần thay đổi phần mềm ERP sẵn có.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Kiến trúc Local AI &amp; Data Masking bảo vệ bí mật kinh doanh</li>
            <li><i class="bi bi-check-circle-fill"></i> Đối soát L/C MT700, Invoice, Packing List chỉ trong 60 giây</li>
            <li><i class="bi bi-check-circle-fill"></i> Triển khai phương pháp Human-in-the-Loop kiểm soát chặt chẽ</li>
          </ul>
          <a href="/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ung-dung-ai-xnk/" class="why-card__link">
            Khám phá giải pháp AI XNK <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <!-- Cột 3: Cập nhật thủ tục hải quan & nghiệp vụ chuyên sâu -->
        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-shield-check"></i> Pháp Lý &amp; Nghiệp Vụ Chuyên Sâu
          </div>
          <h3 class="why-card__title">Cập Nhật Thủ Tục Hải Quan &amp; Nghiệp Vụ</h3>
          <p class="why-card__desc">
            Đồng hành cùng Ban Pháp Lý &amp; Tuân Thủ Hải Quan MDA: Thẩm định mã HS nông sản chế biến/sấy thăng hoa, nắm bắt kịp thời các thông tư thuế cập nhật (85/2026/TT-BTC, 42/2026/TT-BCT, 110/2026/TT-BTC) và đáp ứng các rào cản kỹ thuật quốc tế khắt khe như FDA, BICON, SPS.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Giải mã thông tư thuế 85/2026 &amp; thủ tục hải quan số NSW</li>
            <li><i class="bi bi-check-circle-fill"></i> Thẩm định mã HS, phòng tránh rủi ro truy thu sau thông quan</li>
            <li><i class="bi bi-check-circle-fill"></i> Hướng dẫn đáp ứng tiêu chuẩn kiểm dịch FDA, BICON, SPS</li>
          </ul>
          <a href="/blog/ma-hs-va-tuan-thu-thuong-mai-xnk/" class="why-card__link">
            Xem cập nhật pháp lý XNK <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CHUYÊN GIA ĐÀO TẠO XNK & AI MARKETING -->
  <section class="section section--soft">
    <div class="container">
      <div class="grid-2 expert-grid">
        <!-- Cột Trái: Ảnh Đội ngũ & Floating Badge -->
        <div class="expert-visual">
          <div class="expert-image-box">
            <img src="/media/hero-slide-3.svg" alt="Đội ngũ Chuyên gia Đào tạo XNK & AI Marketing MDA" width="600" height="420" />
            <div class="floating-badge">
              <i class="bi bi-shield-fill-check"></i>
              <div>
                <strong>Đối Tác Tin Cậy</strong>
                <span>Thị trường Úc, Canada, Mỹ, EU</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cột Phải: Nội Dung & Dịch Vụ Đào Tạo -->
        <div class="expert-content">
          <span class="badge">Đội Ngũ Huấn Luyện Thực Chiến</span>
          <h2 class="section-title">Chuyên Gia Đào Tạo XNK &amp; Chiến Lược AI Marketing Nông Sản</h2>
          <p class="lead">
            Dưới sự dẫn dắt của <strong>Ms Jen Phạm</strong> cùng các cố vấn công nghệ &amp; pháp lý, MDA Hub đồng hành từ bước thẩm định tiềm năng đến chuẩn hóa vận hành qua 4 chương trình đào tạo mũi nhọn:
          </p>

          <ul class="program-list">
            <li>
              <div class="program-icon"><i class="bi bi-mortarboard-fill"></i></div>
              <div>
                <strong>Đào Tạo XNK Thực Chiến 1-1 (Ms Jen Phạm):</strong> Huấn luyện cầm tay chỉ việc trên bộ chứng từ thật của chính doanh nghiệp bạn, rèn luyện kỹ năng xử lý ngoại lệ.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-buildings-fill"></i></div>
              <div>
                <strong>Đào Tạo Chuyên Sâu Doanh Nghiệp (In-house):</strong> Chuẩn hóa quy trình xuất khẩu cho toàn bộ phòng ban kinh doanh, logistics &amp; xuất nhập khẩu.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-cpu-fill"></i></div>
              <div>
                <strong>Ứng Dụng AI Cho Doanh Nghiệp XNK:</strong> Tự động hóa rà soát hợp đồng ngoại thương và đối soát chứng từ trong 60 giây bằng Middleware Local AI bảo mật.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-globe-americas"></i></div>
              <div>
                <strong>AI Marketing Nông Sản Quốc Tế:</strong> Chiến lược Story Answering &amp; tối ưu GEO giúp thương hiệu được AI và nhà mua hàng quốc tế tin tưởng trích dẫn.
              </div>
            </li>
          </ul>

          <div class="expert-cta">
            <a href="/dich-vu/" class="btn btn--primary">
              Nhận Tư Vấn Dịch Vụ Đào Tạo <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: HỎI ĐÁP CHUYÊN SÂU & LỢI ÍCH HỢP TÁC (Chia 30% - 70%) -->
  <section class="section section--white faq-section">
    <div class="container">
      <div class="faq-split-grid">
        <!-- Cột Trái 30%: 4 Lợi Ích Cốt Lõi Khi Hợp Tác Cùng MDA Hub -->
        <div class="faq-col-left">
          <span class="badge">Giải Đáp Thực Chiến</span>
          <h2 class="section-title faq-col-left__title">Lợi Ích Hợp Tác Cùng MDA Hub</h2>
          
          <div class="faq-highlight-box">
            <i class="bi bi-patch-question-fill"></i>
            <p>
              "Áp sai Mã HS hoặc thiếu chuẩn bị cho ngoại lệ cảng đến có thể biến lô hàng nông sản trị giá hàng chục nghìn USD thành rủi ro tồn ứ và phạt thuế."
            </p>
          </div>

          <div class="core-benefits-card">
            <h3 class="core-benefits-card__title">
              <i class="bi bi-stars"></i> 4 Lợi Ích Cốt Lõi:
            </h3>
            <ul class="benefit-list">
              <li>
                <i class="bi bi-check-circle-fill"></i>
                <div>
                  <strong>May đo trên hồ sơ thật:</strong> Đào tạo trực tiếp trên Invoice, Packing List, B/L, L/C thực tế; rèn phản xạ xử lý rủi ro ngoại lệ cảng đến.
                </div>
              </li>
              <li>
                <i class="bi bi-check-circle-fill"></i>
                <div>
                  <strong>Tối ưu thuế quan &amp; Bảo vệ mã HS:</strong> Khai thác triệt để ưu đãi FTA (CPTPP, EVFTA) và phòng ngừa truy thu thuế sau thông quan.
                </div>
              </li>
              <li>
                <i class="bi bi-check-circle-fill"></i>
                <div>
                  <strong>Tích hợp Local AI an toàn dữ liệu:</strong> Tự động hóa đối soát với cơ chế Data Masking, tuyệt đối không rò rỉ bí mật thương mại.
                </div>
              </li>
              <li>
                <i class="bi bi-check-circle-fill"></i>
                <div>
                  <strong>Đồng hành chuyên gia 1-1:</strong> Ms Jen Phạm và Hội đồng Pháp lý MDA trực tiếp tháo gỡ điểm nghẽn trong suốt hành trình thực thi.
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- Cột Phải 70%: 5 Câu hỏi thực tế & Câu trả lời chuyên gia -->
        <div class="faq-col-right">
          <FaqAccordion
            items={expertFaqs}
            title="5 Câu Hỏi Thực Tế & Góc Nhìn Tư Vấn Chuyên Gia"
            renderSchema={true}
          />
        </div>
      </div>
