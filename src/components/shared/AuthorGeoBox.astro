---
interface Props {
  role?: 'jen-pham' | 'legal' | 'tue-pham' | string;
  extended?: boolean;
}

const { role = 'tue-pham', extended = false } = Astro.props;

interface AuthorProfile {
  name: string;
  tag: string;
  jobTitle: string;
  avatar: string;
  bio: string;
  zalo?: string;
  email: string;
}

const profiles: Record<string, AuthorProfile> = {
  'jen-pham': {
    name: 'Mrs Jen Phạm',
    tag: 'Đồng Sáng Lập & Chuyên Gia Huấn Luyện 1-1',
    jobTitle: 'Chuyên gia Chiến lược XNK & Ứng dụng AI Nông sản | Đồng sáng lập MDA Hub',
    avatar: '/media/avatar-jen-pham.svg',
    bio: 'Với nhiều năm trực tiếp điều hành xuất khẩu nông sản chế biến sâu (trái cây sấy thăng hoa, nông sản đặc sản ĐBSCL) sang các thị trường khắt khe như Hoa Kỳ, Úc, Canada và EU. Trực tiếp mổ xẻ chứng từ sống (Invoice, Packing List, B/L, L/C MT700, FDA/BICON) và đào tạo nhân sự XNK làm chủ năng lực Quản lý ngoại lệ (Exception Management).',
    zalo: '0904.622.122',
    email: 'tue.pham@mekongdeltaagri.com',
  },
  'legal': {
    name: 'Ban Pháp Lý & Tuân Thủ Hải Quan MDA',
    tag: 'MDA Trade Compliance & Legal Desk',
    jobTitle: 'Hội đồng Thẩm định Pháp lý Thương mại Quốc tế, Mã HS & SPS',
    avatar: '/media/avatar-legal-desk.svg',
    bio: 'Tư vấn chuyên sâu về các thông tư thuế hải quan cập nhật (85/2026/TT-BTC, 42/2026/TT-BCT, 110/2026/TT-BTC), quy tắc thực hành tín dụng chứng từ (UCP 600, ISBP 821) và rào cản kiểm dịch (FDA, BICON, SPS). Chuyển hóa các quy định pháp luật phức tạp thành bảng kiểm tra (Checklist) hành động cụ thể cho doanh nghiệp.',
    zalo: '0904.622.122',
    email: 'tue.pham@mekongdeltaagri.com',
  },
  'tue-pham': {
    name: 'Mr. Tuệ Phạm',
    tag: 'Kiến Trúc Sư Giải Pháp Local AI & GEO',
    jobTitle: 'Trưởng ban Công nghệ AI & Chiến lược Tối ưu GEO | Sáng lập MDA Hub',
    avatar: '/media/avatar-tue-pham.svg',
    bio: 'Chuyên gia thiết kế luồng Middleware Local AI độc lập và luồng Agentic AI tích hợp Data Masking cục bộ. Giúp doanh nghiệp SME tự động hóa đối soát chứng từ, tra cứu mã HS bằng RAG và triển khai AI Marketing chuẩn GEO mà không can thiệp phần mềm ERP cũ hay lo ngại rò rỉ bí mật thương mại theo chuẩn GDPR/EU.',
    zalo: '0904.622.122',
    email: 'tue.pham@mekongdeltaagri.com',
  },
};

const currentAuthor = profiles[role] || profiles['tue-pham'];
---

<aside class={`author-geo-box ${extended ? 'author-geo-box--extended' : ''}`} itemscope itemtype="https://schema.org/Person">
  <div class="author-header">
    <img
      src={currentAuthor.avatar}
      alt={`${currentAuthor.name} - MDA Hub`}
      class="author-avatar"
      width="90"
      height="90"
      itemprop="image"
      loading="lazy"
    />
    <div class="author-meta">
      <span class="author-tag">{currentAuthor.tag}</span>
      <h3 class="author-name" itemprop="name">{currentAuthor.name}</h3>
      <p class="author-title" itemprop="jobTitle">
        {currentAuthor.jobTitle}
      </p>
    </div>
  </div>

  <div class="author-bio" itemprop="description">
    <p>{currentAuthor.bio}</p>
  </div>

  {extended && (
    <div class="author-board">
      <h4 class="board-title">Hội đồng Chuyên môn &amp; Thẩm định Toàn diện MDA Hub:</h4>
      <div class="board-grid">
        <div class="board-item">
          <i class="bi bi-person-check-fill"></i>
          <div>
            <strong>Mrs Jen Phạm:</strong>
            <p>Trực tiếp phụ trách đào tạo thực chiến 1-1 và huấn luyện In-house doanh nghiệp.</p>
          </div>
        </div>
        <div class="board-item">
          <i class="bi bi-shield-check"></i>
          <div>
            <strong>Ban Pháp lý &amp; Hải quan:</strong>
            <p>Thẩm định tính chính xác của Thông tư 85/2026/TT-BTC, 42/2026/TT-BCT và quy tắc FTA.</p>
          </div>
        </div>
        <div class="board-item">
          <i class="bi bi-cpu"></i>
          <div>
            <strong>Mr. Tuệ Phạm:</strong>
            <p>Thiết kế luồng Middleware Local AI, bảo mật Data Masking và tối ưu hóa GEO toàn cầu.</p>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="author-footer">
    <div class="author-contact">
      <a href="https://zalo.me/0904622122" target="_blank" rel="noopener noreferrer" class="contact-pill">
        <i class="bi bi-chat-dots-fill"></i> Zalo: 0904.622.122
      </a>
      <a href={`mailto:${currentAuthor.email}`} class="contact-pill">
        <i class="bi bi-envelope-fill"></i> {currentAuthor.email}
      </a>
    </div>
    <span class="eeat-badge">
      <i class="bi bi-patch-check-fill"></i> Xác thực chuẩn E-E-A-T &amp; GEO
    </span>
  </div>
</aside>

<style>
  .author-geo-box {
    background-color: var(--primary-50);
    border: none;
    border-radius: 16px;
    padding: 24px;
    margin-block: 32px;
  }

  .author-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
  }

  .author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid var(--primary-light);
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--primary-dark);
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .author-name {
    margin: 0;
    font-size: 1.35rem;
    color: var(--primary-deep);
  }

  .author-title {
    margin: 4px 0 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .author-bio p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-primary);
    margin: 0 0 16px;
  }

  .author-board {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed var(--border-subtle);
  }

  .board-title {
    font-size: 1rem;
    color: var(--primary-deep);
    margin-bottom: 12px;
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 992px) {
    .board-grid {
      grid-template-columns: 1fr;
    }
    .author-header {
      flex-direction: column;
      text-align: center;
    }
  }

  .board-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #ffffff;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 0.88rem;
  }

  .board-item i {
    font-size: 20px;
    color: var(--primary-dark);
    margin-top: 2px;
  }

  .board-item p {
    margin: 4px 0 0;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .author-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(141, 196, 53, 0.25);
  }

  .author-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #ffffff;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--primary-dark);
    font-weight: 600;
  }

  .contact-pill:hover {
    background-color: var(--primary-dark);
    color: #ffffff;
  }

  .eeat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary-dark);
  }
</style>
