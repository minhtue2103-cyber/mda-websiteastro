---

<section class="section section--white training-gallery-section" id="tai-lieu-dao-tao">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge">Nghiệp Vụ &amp; Biểu Mẫu Thực Chiến</span>
      <h2 class="section-title shared-block__title">{title}</h2>
      <p class="lead">{subtitle}</p>
    </div>
  </div>

  <!-- Farm Table ft-services-way ft-bg-in Style: Photo Background & Infinite Auto-Moving Sliding Track -->
  <div class="gallery-slider-wrapper">
    <div class="gallery-marquee-container" id="galleryMarquee">
      <div class="gallery-marquee-track" id="marqueeTrack">
        {doubleModules.map((m, index) => (
          <div
            class="gallery-card gallery-card--bg"
            style={`background-image: url('${m.image}');`}
            data-index={index}
          >
            <div class="gallery-card__inner">
              <div class="gallery-card__top">
                <span class="module-tag">{m.tag}</span>
                <span class="gallery-card__icon-wrap">
                  <i class={`bi ${m.icon}`}></i>
                </span>
              </div>
              <h3 class="gallery-card__title">{m.title}</h3>
              <p class="gallery-card__desc">{m.desc}</p>
              <div class="gallery-card__action">
                <a
                  href={encodeURI(m.downloadUrl)}
                  download={m.fileName}
                  class="btn-card-download"
                  title={`Tải file tài liệu ${m.fileName}`}
                >
                  <i class="bi bi-file-earmark-arrow-down-fill"></i>
                  <span>Tải {m.code} ({m.fileFormat})</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container" style="margin-top: 56px;">
    <!-- Farm Table cat_bottom_sec ft-bg-in Style: Photo Background PDF Download Banner -->
    <div class="pdf-download-banner cat_bottom_sec ft-bg-in">
      <div class="cat-bottom-overlay"></div>
      <div class="pdf-banner-content">
        <div class="pdf-icon-wrapper">
          <i class="bi bi-file-earmark-pdf-fill"></i>
        </div>
        <div class="pdf-info">
          <span class="cat-bottom-pill">
            <i class="bi bi-download"></i> Tài Liệu Độc Quyền Miễn Phí
          </span>
          <h3 class="pdf-title">Tải Trọn Bộ Tài Liệu Đào Tạo (1 File PDF)</h3>
          <p class="pdf-desc">
            File PDF tổng hợp khung chương trình 6 Module chuyên sâu, sơ đồ quy trình Tích Hợp AI vào Doanh Nghiệp.
          </p>
        </div>
      </div>

      <div class="pdf-actions">
        <a href={pdfUrl} download="/media/document/Ứng dụng AI vào Doanh Nghiệp.docx" class="btn btn--secondary btn--lg">
          <i class="bi bi-file-earmark-arrow-down-fill"></i> Tải Trọn Bộ (.PDF)
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .text-center {
    text-align: center;
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 40px;
  }

  .text-center .section-title {
    display: inline-block;
    margin-top: 10px;
  }

  /* =====================================================================
     FARM TABLE ft-services-way ft-bg-in STYLE: PHOTO BG & SLIDING AUTO MOVING
     ===================================================================== */
  .gallery-slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: 10px;
  }

  /* Fade masks on sides for elegant infinite look */
  .gallery-slider-wrapper::before,
  .gallery-slider-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(20px, 5vw, 80px);
    z-index: 5;
    pointer-events: none;
  }

  .gallery-slider-wrapper::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
  }

  .gallery-slider-wrapper::after {
    right: 0;
    background: linear-gradient(270deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
  }

  .gallery-marquee-container {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-marquee-container::-webkit-scrollbar {
    display: none;
  }

  .gallery-marquee-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marqueeSlide 40s linear infinite;
    padding-inline: 16px;
  }

  /* Pause auto-moving on hover so user can read / click */
  .gallery-marquee-track:hover,
  .gallery-marquee-track:has(.is-hovered) {
    animation-play-state: paused;
  }

  @keyframes marqueeSlide {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Half of the doubled list */
      transform: translateX(-50%);
    }
  }

  /* Card with Photo Background (ft-bg-in) */
  .gallery-card--bg {
    position: relative;
    width: 360px;
    min-width: 340px;
    height: 400px;
    border-radius: var(--card-radius);
    overflow: hidden;
    background-size: cover;
    background-position: left center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    border: none;
    flex-shrink: 0;
  }

  .gallery-card--bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 45, 26, 0.35) 0%,
      rgba(14, 38, 22, 0.85) 60%,
      rgba(10, 26, 15, 0.96) 100%
    );
    transition: background var(--transition-base);
    z-index: 1;
  }

  .gallery-card--bg:hover,
  .gallery-card--bg.is-hovered {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.2);
  }

  .gallery-card--bg:hover::before,
  .gallery-card--bg.is-hovered::before {
    background: linear-gradient(
      180deg,
      rgba(16, 45, 26, 0.2) 0%,
      rgba(14, 38, 22, 0.8) 55%,
      rgba(10, 26, 15, 0.98) 100%
    );
  }

  .gallery-card__inner {
    position: relative;
    z-index: 2;
    padding: 26px 24px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: flex-end;
  }

  .gallery-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: auto;
  }

  .module-tag {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    padding: 4px 12px;
    border-radius: 14px;
    color: #ffffff;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .gallery-card__icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .gallery-card__title {
    font-size: 1.15rem;
    color: #ffffff;
    margin: 12px 0 0;
    line-height: 1.4;
    font-family: var(--font-heading);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default state: Ẩn desc, hiệu ứng chuẩn bị rise up */
  .gallery-card__desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.55;
    margin: 0;
    max-height: 0;
    opacity: 0;
    transform: translateY(24px);
    overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease,
                transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                margin 0.35s ease;
    pointer-events: none;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  /* Hover state: Show thêm desc với hiệu ứng animation rise up */
  .gallery-card--bg:hover .gallery-card__desc,
  .gallery-card--bg.is-hovered .gallery-card__desc,
  .gallery-card__inner.is-hovered .gallery-card__desc {
    max-height: 140px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 10px;
    margin-bottom: 14px;
    pointer-events: auto;
  }

  .gallery-card__action {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    transform: translateY(20px);
    overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease 0.05s,
                transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.05s,
                margin 0.35s ease;
    pointer-events: none;
  }

  .gallery-card--bg:hover .gallery-card__action,
  .gallery-card--bg.is-hovered .gallery-card__action,
  .gallery-card__inner.is-hovered .gallery-card__action {
    max-height: 60px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 4px;
    pointer-events: auto;
  }

  .btn-card-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--secondary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 20px;
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  .btn-card-download:hover {
    background: var(--secondary-hover);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
  }

  .link-view-summary {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .link-view-summary:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* =====================================================================
     FARM TABLE cat_bottom_sec ft-bg-in STYLE: PHOTO BG PDF DOWNLOAD BANNER
     ===================================================================== */
  .cat_bottom_sec.ft-bg-in {
    position: relative;
    background-image: url('https://picsum.photos/id/1018/1200/500');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: var(--card-radius);
    padding: 44px 48px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    border: none;
  }

  .cat-bottom-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(24, 65, 42, 0.94) 0%,
      rgba(15, 38, 24, 0.96) 60%,
      rgba(10, 24, 15, 0.98) 100%
    );
    z-index: 1;
  }

  .pdf-banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .cat-bottom-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 144, 70, 0.22);
    border: 1px solid var(--secondary);
    color: #ffb885;
    padding: 4px 12px;
    border-radius: 14px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .pdf-icon-wrapper {
    font-size: 56px;
    color: #ffffff;
    line-height: 1;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    width: 88px;
    height: 88px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .pdf-info {
    max-width: 620px;
  }

  .pdf-title {
    font-size: 1.35rem;
    color: #ffffff;
    margin: 0 0 10px;
    line-height: 1.35;
  }

  .pdf-desc {
    font-size: 0.93rem;
    color: #e5f6c8;
    margin: 0;
    line-height: 1.6;
  }

  .pdf-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
