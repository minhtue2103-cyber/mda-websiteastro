# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit syntax files
*.astro text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.htaccess text eol=lf
_headers text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary

