    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 960px) {
    .cat_bottom_sec.ft-bg-in {
      flex-direction: column;
      text-align: center;
      padding: 36px 24px;
      gap: 28px;
    }

    .pdf-banner-content {
      flex-direction: column;
    }

    .pdf-actions {
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .gallery-card--bg {
      width: 290px;
      min-width: 280px;
      height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card__desc,
    .gallery-card__action,
    .gallery-card__title {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupGalleryCardHover() {
    const cardInners = document.querySelectorAll<HTMLElement>('.gallery-card__inner');
    const marqueeTrack = document.getElementById('marqueeTrack');
    if (!cardInners.length) return;

    cardInners.forEach((inner) => {
      const card = inner.closest<HTMLElement>('.gallery-card');

      // 1. Mouse enter: kích hoạt trạng thái hover rise up
      inner.addEventListener('mouseenter', () => {
        inner.classList.add('is-hovered');
        if (card) card.classList.add('is-hovered');
        if (marqueeTrack) marqueeTrack.style.animationPlayState = 'paused';
      });

      // 2. Mouse leave: thu gọn về trạng thái mặc định (chỉ hiện H3)
      inner.addEventListener('mouseleave', () => {
        inner.classList.remove('is-hovered');
        if (card) card.classList.remove('is-hovered');
        const anyHovered = document.querySelector('.gallery-card__inner.is-hovered');
        if (!anyHovered && marqueeTrack) {
          marqueeTrack.style.animationPlayState = 'running';
        }
      });

      // 3. Hỗ trợ Touch/Click trên màn hình cảm ứng & di động
      inner.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Nếu click trực tiếp vào nút tải file, không chặn sự kiện click
        if (target.closest('.btn-card-download')) {
          return;
        }

        const isCurrentlyHovered = inner.classList.contains('is-hovered');

        // Thu gọn tất cả các thẻ khác
        cardInners.forEach((other) => {
          if (other !== inner) {
            other.classList.remove('is-hovered');
            const otherCard = other.closest<HTMLElement>('.gallery-card');
            if (otherCard) otherCard.classList.remove('is-hovered');
          }
        });

        // Chuyển đổi trạng thái thẻ hiện tại
        if (!isCurrentlyHovered) {
          inner.classList.add('is-hovered');
          if (card) card.classList.add('is-hovered');
          if (marqueeTrack) marqueeTrack.style.animationPlayState = 'paused';
        } else {
          inner.classList.remove('is-hovered');
          if (card) card.classList.remove('is-hovered');
          if (marqueeTrack) marqueeTrack.style.animationPlayState = 'running';
        }
      });

      // 4. Hỗ trợ Focus bằng bàn phím (Accessibility)
      inner.addEventListener('focusin', () => {
        inner.classList.add('is-hovered');
        if (card) card.classList.add('is-hovered');
        if (marqueeTrack) marqueeTrack.style.animationPlayState = 'paused';
      });

      inner.addEventListener('focusout', (e) => {
        const related = (e as FocusEvent).relatedTarget as Node | null;
        if (!related || !inner.contains(related)) {
          inner.classList.remove('is-hovered');
          if (card) card.classList.remove('is-hovered');
          const anyHovered = document.querySelector('.gallery-card__inner.is-hovered');
          if (!anyHovered && marqueeTrack) {
            marqueeTrack.style.animationPlayState = 'running';
          }
        }
      });
    });

    // 5. Đóng khi click bên ngoài danh sách thẻ
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.gallery-card')) {
        cardInners.forEach((inner) => {
          inner.classList.remove('is-hovered');
          const card = inner.closest<HTMLElement>('.gallery-card');
          if (card) card.classList.remove('is-hovered');
        });
        if (marqueeTrack) marqueeTrack.style.animationPlayState = 'running';
      }
    });
  }

  setupGalleryCardHover();
  document.addEventListener('astro:page-load', setupGalleryCardHover);
</script>
