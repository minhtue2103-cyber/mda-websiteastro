---
interface Props {
  title?: string;
  subtitle?: string;
  googleFormUrl?: string;
}

const {
  title = "Đăng Ký Tư Vấn & Nhận Lộ Trình Đào Tạo Thực Chiến",
  subtitle = "Kết nối trực tiếp cùng Chuyên gia Ms Jen Phạm và Hội đồng Pháp lý MDA Hub để giải quyết triệt để các rào cản chứng từ, mã HS và quy chuẩn xuất khẩu nông sản.",
  googleFormUrl = "https://forms.google.com/", // Thay bằng link Google Form của bạn
} = Astro.props;
---

<div class="contact-cta-card" id="contact-form-block">
  <div class="contact-cta-grid">
    <!-- Visual / Image Side -->
    <div class="contact-visual">
      <div class="visual-inner">
        <img
          src="/media/avatar-jen-pham.svg"
          alt="Ms Jen Phạm - Chuyên gia Chiến lược XNK MDA Hub"
          class="expert-avatar"
          width="120"
          height="120"
          loading="lazy"
        />
        <div class="visual-text">
          <span class="expert-name">Ms Jen Phạm</span>
          <span class="expert-title">Đồng Sáng Lập &amp; Chuyên Gia XNK MDA Hub</span>
        </div>
        <div class="trust-pills">
          <span class="trust-pill"><i class="bi bi-shield-check"></i> Đào tạo 1-1</span>
          <span class="trust-pill"><i class="bi bi-cpu"></i> Ứng dụng Local AI</span>
          <span class="trust-pill"><i class="bi bi-check2-circle"></i> Chứng từ thực tế</span>
        </div>
      </div>
    </div>

    <!-- Content & Action Side -->
    <div class="contact-content">
      <span class="badge badge--accent">Đăng Ký Nhanh Qua Biểu Mẫu</span>
      <h3 class="contact-title">{title}</h3>
      <p class="contact-desc">{subtitle}</p>

      <div class="action-box">
        <a
          href={googleFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary btn-form-cta"
        >
          <i class="bi bi-ui-checks"></i>
          <span>Mở Biểu Mẫu Đăng Ký Tư Vấn (Google Form)</span>
          <i class="bi bi-box-arrow-up-right external-icon"></i>
        </a>
        <span class="form-hint">* Biểu mẫu mở trong tab mới. Thời gian phản hồi trong vòng 24 giờ làm việc.</span>
      </div>

      <div class="quick-contact-row">
        <div class="quick-item">
          <i class="bi bi-telephone-outbound-fill"></i>
          <div>
            <span class="quick-label">Hotline / Zalo trực tiếp:</span>
            <a href="tel:0904622122" class="quick-val">0904.622.122 (Mr. Tuệ Phạm)</a>
          </div>
        </div>

        <div class="quick-item">
          <i class="bi bi-envelope-check-fill"></i>
          <div>
            <span class="quick-label">Email chuyên môn:</span>
            <a href="mailto:tue.pham@mekongdeltaagri.com" class="quick-val">tue.pham@mekongdeltaagri.com</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-cta-card {
    background: #ffffff;
    border-radius: var(--card-radius);
    padding: 36px 40px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 768px) {
    .contact-cta-card {
      padding: 24px;
    }
  }

  .contact-cta-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (max-width: 860px) {
    .contact-cta-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 24px;
    }
  }

  /* Visual side */
  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--primary-50);
    padding: 28px 20px;
    border-radius: 16px;
    border: 1px dashed var(--primary-light);
  }

  .expert-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid #ffffff;
    box-shadow: var(--shadow-sm);
    margin-bottom: 12px;
  }

  .visual-text {
    text-align: center;
    margin-bottom: 14px;
  }

  .expert-name {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary-deep);
  }

  .expert-title {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 4px;
    line-height: 1.35;
  }

  .trust-pills {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .trust-pill {
    background: #ffffff;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  /* Content side */
  .contact-title {
    font-size: 1.45rem;
    color: var(--primary-deep);
    margin: 8px 0 10px;
  }

  .contact-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .action-box {
    margin-bottom: 24px;
  }

  .btn-form-cta {
    padding: 16px 28px;
    font-size: 1.05rem;
    font-weight: 700;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(255, 144, 70, 0.4);
    transition: all var(--transition-base);
  }

  .btn-form-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(255, 144, 70, 0.5);
  }

  .external-icon {
    font-size: 0.85em;
    opacity: 0.85;
  }

  .form-hint {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 8px;
    font-style: italic;
  }

  /* Quick contact */
  .quick-contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 860px) {
    .quick-contact-row {
      justify-content: center;
    }
  }

  .quick-item {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
  }

  .quick-item i {
    font-size: 22px;
    color: var(--primary-dark);
  }

  .quick-label {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .quick-val {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--primary-deep);
  }

  .quick-val:hover {
    color: var(--secondary);
  }
</style>
