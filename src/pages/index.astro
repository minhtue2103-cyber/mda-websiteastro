---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialSection from '../components/shared/TestimonialSection.astro';
import TrainingGalleryPdf from '../components/shared/TrainingGalleryPdf.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import HeroWave from '../components/ui/HeroWave.astro';

const heroSlides = [
  {
    image: '/media/MDA-Hub-Banner-smaller.webp',
    alt: 'Sự thật về Xuất khẩu Trái cây Việt Nam & Chuỗi cung ứng ĐBSCL',
  },
  {
    image: '/media/nhung-linkedin-11.webp',
    alt: 'Tuân thủ & Xác thực Tiêu chuẩn FDA, BICON, SPS bằng AI',
  },
  {
    image: '/media/nhung-linkedin-12.webp',
    alt: 'Chiến lược AI Marketing Nông sản & Tối ưu hóa GEO Toàn cầu',
  },
  {
    image: '/media/nhung-linkedin-13.webp',
    alt: 'Phân loại Mã HS & Tuân thủ Thông tư Thuế Hải quan XNK 85/2026/TT-BTC',
  },
];

const expertFaqs = [
  {
    question: "Làm thế nào để ứng dụng AI vào rà soát L/C và hợp đồng ngoại thương mà không lo ngại rò rỉ bí mật thương mại?",
    answer: "MDA Hub áp dụng giải pháp AI tuân thủ bảo mật kết hợp Prompt Template chuyên ngành ngoại thương và cơ chế Data Masking ngay tại máy trạm. Trước khi dữ liệu chứng từ được đưa vào mô hình xử lý, toàn bộ thông tin nhạy cảm (tên đối tác, đơn giá, số tài khoản ngân hàng, điều khoản thương mại độc quyền) đều được ẩn danh hóa. AI tập trung đối soát chéo tính hợp lệ giữa Hợp đồng, L/C và bộ chứng từ (Invoice, B/L, C/O, Phyto) dựa trên tập quán quốc tế (UCP 600, ISBP 745, Incoterms 2020), loại bỏ rủi ro điều khoản gài bẫy mà không làm rò rỉ dữ liệu mật của doanh nghiệp."
  },
  {
    question: "Tại sao doanh nghiệp xuất khẩu trái cây sấy thăng hoa và nông sản chế biến thường gặp rủi ro phạt thuế hoặc ách tắc mã HS tại thị trường đích (như EU, Canada)?",
    answer: "Trái cây tươi (Chương 08) và trái cây qua xử lý nhiệt hoặc sấy thăng hoa có bổ sung đường/phụ gia (thường chuyển sang Chương 20 hoặc 21) chịu mức thuế suất, quy tắc xuất xứ (PSR) và tiêu chuẩn kiểm tra an toàn thực phẩm hoàn toàn khác nhau. Sự không đồng nhất giữa danh mục quản lý chuyên ngành và biểu thuế, hoặc sai lệch ở cấp phân nhóm 6 số theo 6 quy tắc GRI, dễ khiến cơ quan hải quan nước nhập khẩu phân loại lại mã HS, truy thu thuế sau thông quan kèm tiền phạt lớn, thậm chí bị nghi ngờ gian lận thuế. MDA hỗ trợ doanh nghiệp xây dựng Bảng thẩm định thành phần, định mức chế biến sâu và thực hiện thủ tục Xác định trước mã HS (Prior Determination) để bảo đảm an toàn pháp lý tuyệt đối."
  },
  {
    question: "Doanh nghiệp SME hoặc hợp tác xã nông sản có bộ máy tinh gọn (<5 người) thì có thể tự chủ quy trình xuất nhập khẩu và ứng dụng AI được không?",
    answer: "Hoàn toàn khả thi. MDA thiết kế mô hình đào tạo và chuyển giao thực chiến may đo cho các đội ngũ tinh gọn (đã chứng minh hiệu quả qua các case study vận hành Trading 2 chiều tuyến Canada và nông sản chế biến EU). Không cần đầu tư phần mềm đắt đỏ, doanh nghiệp được hướng dẫn chuẩn hóa luồng làm việc liên phòng ban (Sales - QC - Kho), ứng dụng AI để tự động hóa rà soát lỗi chứng từ (Invoice, Packing List, C/O, Phyto, Health Cert) và tự kê khai C/O ưu đãi FTA (Form EUR.1, CPTPP), giúp tiết kiệm hơn 50% thời gian xử lý sự vụ và tự chủ đến 80% quy trình xuất khẩu trực tiếp."
  },
  {
    question: "Chương trình Huấn luyện Thực chiến của MDA có điểm gì khác biệt so với các khóa học xuất nhập khẩu đại trà trên thị trường?",
    answer: "Khác biệt cốt lõi nằm ở định hướng chuyên sâu ngành dọc (trái cây nhiệt đới, nông sản chế biến sâu, hàng sức khỏe/mỹ phẩm) và giải quyết các bài toán rủi ro cao cấp: (1) Thực hành trực tiếp 100% trên bộ chứng từ thật của chính doanh nghiệp; (2) Giải mã kỹ thuật Audit L/C, ứng dụng giải pháp L/C UPAS giúp người bán nhận tiền sớm trong khi đối tác vẫn được trả chậm; (3) Cài cắm bộ điều khoản phòng thủ quốc tế (Model Clauses) về dung sai chất lượng/độ ẩm để chặn rủi ro khiếu nại (Quality Claims); (4) Tích hợp năng lực AI thẩm định đối tác và rà soát trọn bộ chứng từ trước khi tàu chạy."
  },
  {
    question: "MDA Agri Hub hỗ trợ doanh nghiệp tháo gỡ 'mê cung quy định' (Compliance Maze: BICON Úc, FDA Mỹ, Health Canada, SPS) theo lộ trình như thế nào?",
    answer: "MDA đồng hành theo quy trình phân tích và xử lý 3 bước chuẩn: Căn cứ pháp lý -> Xác định rủi ro kỹ thuật/tài chính -> Kịch bản hành động đa bên. Chúng tôi cung cấp cẩm nang thực chiến (Export Playbooks), rà soát tính đồng bộ giữa chứng nhận an toàn sinh học (Phyto, Health Cert, NPN Health Canada) với mã HS và tờ khai hải quan, đồng thời tích hợp công cụ tra cứu tự động và tư vấn chuyên sâu về rào cản kỹ thuật SPS/Kiểm dịch của các nước thành viên WTO, giúp lô hàng thông quan suôn sẻ ngay từ lần đầu xuất bến."
  }
];

<BaseLayout
  title="Mekong Delta Agri (MDA Hub) | Đào tạo XNK Thực chiến, Tư vấn Pháp lý & Ứng dụng AI Doanh Nghiệp"
  description="Hệ sinh thái tri thức và đào tạo Xuất Nhập Khẩu nông sản hàng đầu Việt Nam. Huấn luyện thực chiến 1-1 cùng Ms Jen Phạm, tư vấn chứng từ thương mại, mã HS, tuân thủ tiêu chuẩn FDA/BICON/SPS và đào tạo ứng dụng AI chuyên sâu cho doanh nghiệp XNK."
>
  <!-- SECTION 1: HERO & WELCOME TO MDA AGRO KNOWLEDGE HUB (Farm Table Style Bleed-Right) -->
  <section class="hero-section hero-section--bleed">
    <div class="hero-grid hero-grid--bleed">
      <!-- Left Column: Chào Mừng & Định Vị (aligned with container left) -->
      <div class="hero-left hero-bleed-left">
        <span class="badge">Cộng đồng TP.HCM về Chứng từ &amp; AI XNK</span>
        <h1 class="section-title hero-title">
          Đào tạo XNK Thực chiến & Ứng dụng AI Doanh Nghiệp
        </h1>
        <p class="lead hero-lead">
          <strong>MDA Hub</strong> là hệ sinh thái tri thức về Xuất Nhập Khẩu toàn diện dành cho ngành nông sản Việt Nam. Dưới sự dẫn dắt chuyên môn của <strong>Ms Jen Phạm</strong>, chúng tôi đơn giản hóa các rào cản pháp lý xuyên biên giới thông qua tư vấn tuân thủ chi tiết (<strong>FDA, BICON, SPS</strong>), phân loại mã HS chính xác và tích hợp AI an toàn cho doanh nghiệp tự chủ chuỗi cung ứng toàn cầu.
        </p>
        <div class="hero-cta-group">
          <a href="https://forms.google.com/" target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
            <i class="bi bi-clipboard2-check"></i> Đăng Ký Tư Vấn
          </a>
          <a href="/dich-vu/" class="btn btn--outline">
            <i class="bi bi-arrow-right-circle"></i> Dịch Vụ của MDA
          </a>
        </div>
      </div>

      <!-- Right Column: Photo Full Chiều Cao, Width Tràn Ra Phải Màn Hình (Không Border) -->
      <div class="hero-right hero-bleed-right">
        <div class="hero-slider hero-slider--full" id="heroSlider">
          <div class="hero-slides-wrapper" id="heroSlidesTrack">
            {heroSlides.map((slide, index) => (
              <div class={`hero-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                <div class="hero-slide__image-wrap hero-slide__image-wrap--full">
                  <img
                    src={slide.image}
                    alt={slide.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              </div>
            ))}
          </div>

          <!-- Slider Dots -->
          <div class="slider-dots slider-dots--floating" id="sliderDots">
            {heroSlides.map((_, i) => (
              <button
                type="button"
                class={`dot-btn ${i === 0 ? 'active' : ''}`}
                data-slide={i}
                aria-label={`Chuyển đến hình ảnh ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- SVG Wave Divider (Animated on Homepage) -->
    <HeroWave animated={true} id="home" />
  </section>

  <!-- SECTION 2: VÌ SAO CHỌN CHÚNG TÔI (Agro-Export Knowledge Style) -->
  <section class="section section--white why-choose-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Vì Sao Chọn Chúng Tôi</h2>
        <p class="lead">
          Mekong Delta Agri (MDA Hub) mang đến bộ giải pháp 3 trụ cột vững chắc, kết hợp giữa nghiệp vụ xuất nhập khẩu nông sản thực chiến và công nghệ AI bảo mật cao cấp dành riêng cho doanh nghiệp Việt Nam.
        </p>
      </div>

      <div class="grid-3 why-choose-grid">
        <!-- Cột 1: Đào tạo ứng dụng quy trình -->
        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-person-workspace"></i> Đào Tạo Ứng Dụng Quy Trình
          </div>
          <h3 class="why-card__title">Đào Tạo Ứng Dụng Quy Trình Thực Tế</h3>
          <p class="why-card__desc">
            Chương trình huấn luyệntheo đặc thù mặt hàng (trái cây tươi/sấy thăng hoa/ nông sản) và năng lực thực tế của doanh nghiệp. Học viên trực tiếp rà soát chứng từ  rèn luyện kỹ năng Quản lý rủi ro L/C và tháo gỡ điểm nghẽn thực chiến cùng Ms Jen Phạm.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Trực tiếp rà soát các rủi ro trong các tình huống thực tế</li>
            <li><i class="bi bi-check-circle-fill"></i> Kỹ năng xử lý thực chiến: trễ tàu, sai khác B/L, luồng Đỏ</li>
            <li><i class="bi bi-check-circle-fill"></i> Đồng bộ quy trình liên phòng ban Kinh doanh &amp; Logistics</li>
          </ul>
          <a href="/dich-vu/dao-tao-xnk-thuc-chien-1-1/" class="why-card__link">
            Tìm hiểu khóa đào tạo 1-1 <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <!-- Cột 2: Tích hợp AI Business Integration -->
        <div class="why-card why-card--highlight">
          <div class="why-card__badge">
            <i class="bi bi-cpu-fill"></i> AI Business Integration
          </div>
          <h3 class="why-card__title">Tích Hợp AI Business Vào Quy Trình XNK</h3>
          <p class="why-card__desc">
            Giải pháp AI bảo mật doanh nghiệp, dữ liệu 100% trong hệ thống - chuẩn GDPR/EU với công nghệ Data Masking. Tự động hóa rà soát Hợp đồng ngoại thương, đối soát chứng từ và kiểm tra sự phù hợp điều khoản UCP 600 trong 60 giây mà không cần thay đổi phần mềm ERP sẵn có.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Kiến trúc Local AI &amp; Data Masking bảo vệ bí mật kinh doanh</li>
            <li><i class="bi bi-check-circle-fill"></i> Đối soát L/C MT700, Invoice, Packing List chỉ trong 60 giây</li>
            <li><i class="bi bi-check-circle-fill"></i> Triển khai phương pháp Human-in-the-Loop kiểm soát chặt chẽ</li>
          </ul>
          <a href="/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ung-dung-ai-xnk/" class="why-card__link">
            Khám phá giải pháp AI XNK <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <!-- Cột 3: Cập nhật thủ tục hải quan & nghiệp vụ chuyên sâu -->
        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-shield-check"></i> Pháp Lý &amp; Nghiệp Vụ Chuyên Sâu
          </div>
          <h3 class="why-card__title">Cập Nhật Thủ Tục Hải Quan &amp; Nghiệp Vụ</h3>
          <p class="why-card__desc">
            Đồng hành cùng Ban Pháp Lý &amp; Tuân Thủ Hải Quan MDA: Thẩm định mã HS nông sản chế biến/sấy thăng hoa, nắm bắt kịp thời các thông tư thuế cập nhật (85/2026/TT-BTC, 42/2026/TT-BCT, 110/2026/TT-BTC) và đáp ứng các rào cản kỹ thuật quốc tế khắt khe như FDA, BICON, SPS.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Giải mã thông tư thuế 85/2026 &amp; thủ tục hải quan số NSW</li>
            <li><i class="bi bi-check-circle-fill"></i> Thẩm định mã HS, phòng tránh rủi ro truy thu sau thông quan</li>
            <li><i class="bi bi-check-circle-fill"></i> Hướng dẫn đáp ứng tiêu chuẩn kiểm dịch FDA, BICON, SPS</li>
          </ul>
          <a href="/blog/ma-hs-va-tuan-thu-thuong-mai-xnk/" class="why-card__link">
            Xem cập nhật pháp lý XNK <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CHUYÊN GIA ĐÀO TẠO XNK & AI MARKETING -->
  <section class="section section--soft">
    <div class="container">
      <div class="grid-2 expert-grid">
        <!-- Cột Trái: Ảnh Đội ngũ & Floating Badge -->
        <div class="expert-visual">
          <div class="expert-image-box">
            <img src="/media/nhung-linkedin-14-scaled.webp" alt="Đội ngũ Chuyên gia Đào tạo XNK & AI Marketing MDA" width="600" height="420" />
            <div class="floating-badge">
              <i class="bi bi-shield-fill-check"></i>
              <div>
                <strong>Đối Tác Tin Cậy</strong>
                <span>Thị trường Úc, Canada, Mỹ, EU</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cột Phải: Nội Dung & Dịch Vụ Đào Tạo -->
        <div class="expert-content">
          <span class="badge">Đội Ngũ Huấn Luyện Thực Chiến</span>
          <h2 class="section-title">Chuyên Gia Đào Tạo XNK &amp; Chiến Lược AI Compliance</h2>
          <p class="lead">
            Dưới sự dẫn dắt của <strong>Ms Jen Phạm</strong> cùng các cố vấn công nghệ &amp; pháp lý, MDA Hub đồng hành từ bước thẩm định tiềm năng đến chuẩn hóa vận hành qua 4 chương trình đào tạo mũi nhọn:
          </p>

          <ul class="program-list">
            <li>
              <div class="program-icon"><i class="bi bi-mortarboard-fill"></i></div>
              <div>
                <strong>Đào Tạo XNK Thực Chiến 1-1 (Ms Jen Phạm):</strong> Huấn luyện rà soát bộ chứng từ thật của chính doanh nghiệp bạn, rèn luyện kỹ năng xử lý rủi ro.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-buildings-fill"></i></div>
              <div>
                <strong>Đào Tạo Chuyên Sâu Doanh Nghiệp (In-house):</strong> Chuẩn hóa quy trình xuất khẩu cho toàn bộ phòng ban kinh doanh, logistics &amp; xuất nhập khẩu.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-cpu-fill"></i></div>
              <div>
                <strong>Ứng Dụng AI Cho Doanh Nghiệp XNK:</strong> Tự động hóa rà soát hợp đồng ngoại thương và đối soát chứng từ trong 60 giây bằng Middleware Local AI bảo mật.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-globe-americas"></i></div>
              <div>
                <strong>AI Marketing Nông Sản Quốc Tế:</strong> Chiến lược Story Answering &amp; tối ưu GEO giúp thương hiệu được AI và nhà mua hàng quốc tế tin tưởng trích dẫn.
              </div>
            </li>
          </ul>

          <div class="expert-cta">
            <a href="/dich-vu/" class="btn btn--primary">
              Nhận Tư Vấn Dịch Vụ Đào Tạo <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: HỎI ĐÁP CHUYÊN SÂU & LỢI ÍCH HỢP TÁC (Chia 30% - 70%) -->
  <section class="section section--white faq-section">
    <div class="container">
      <div class="faq-split-grid">
        <!-- Cột Trái 30%: 4 Lợi Ích Cốt Lõi Khi Hợp Tác Cùng MDA Hub -->
        <div class="faq-col-left">
          <span class="badge">Giải Đáp Thực Chiến</span>
          <h2 class="section-title faq-col-left__title">Hợp Tác Cùng MDA</h2>
          
          <!-- 4 Lợi Ích Cốt Lõi (Dạng ft-sub-benefit Bỏ Border) -->
          <div class="core-benefits-wrapper">
            <h3 class="core-benefits__title">
              <i class="bi bi-stars"></i> 4 Lợi Ích Cốt Lõi:
            </h3>
            <div class="ft-sub-benefits-list">
              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-file-earmark-check-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Rà soát rủi ro trên hồ sơ doanh nghiệp</h4>
                  <p class="ft-sub-benefit__desc">
                    Đào tạo trực tiếp trên Invoice, Packing List, B/L, L/C thực tế; rèn phản xạ xử lý rủi ro ngoại lệ cảng đến.
                  </p>
                </div>
              </div>

              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-shield-check"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Tối ưu thuế quan &amp; Bảo vệ mã HS</h4>
                  <p class="ft-sub-benefit__desc">
                    Khai thác triệt để ưu đãi FTA (CPTPP, EVFTA) và phòng ngừa truy thu thuế sau thông quan.
                  </p>
                </div>
              </div>

              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-cpu-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
