---
import { getCollection, type CollectionEntry } from 'astro:content';
import ChildDetailLayout from '../../layouts/ChildDetailLayout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Tin tức', url: '/tin-tuc/' },
  { name: entry.data.title, url: `/tin-tuc/${entry.slug}/` },
];
---

<ChildDetailLayout
  type="news"
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  headlinePhoto={entry.data.headlinePhoto}
  headlinePhotoAlt={entry.data.headlinePhotoAlt}
  headlinePhotoCaption={entry.data.headlinePhotoCaption}
  breadcrumbs={breadcrumbs}
>
  <Content />
</ChildDetailLayout>
