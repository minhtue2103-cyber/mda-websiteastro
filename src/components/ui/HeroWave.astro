---
interface Props {
  animated?: boolean;
  id?: string;
  className?: string;
}

const {
  animated = false,
  id = "hero-wave",
  className = "",
} = Astro.props;

const gradientId = `waveGradient-${id}`;
---

<div class={`hero-wave-container ${className} ${animated ? 'hero-wave--animated' : 'hero-wave--static'}`}>
  <svg
    width="100%"
    height="100%"
    viewBox="0 0 1440 590"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <!-- Màu sắc thương hiệu MDA: Xanh đọt chuối -> Xanh tươi -> Xanh rêu đậm -->
      <linearGradient id={gradientId} x1="0%" y1="50%" x2="100%" y2="50%">
        <stop offset="5%" stop-color="#8dc435"></stop>
        <stop offset="50%" stop-color="#34c435"></stop>
        <stop offset="95%" stop-color="#2d5e2d"></stop>
      </linearGradient>
    </defs>

    <!-- Path 0: Lớp sóng sau (Translucent) -->
    <path
      d="M 0,600 L 0,150 C 92.83253588516749,127.66507177033492 185.66507177033498,105.33014354066985 283,114 C 380.334928229665,122.66985645933015 482.17224880382776,162.3444976076555 587,162 C 691.8277511961722,161.6555023923445 799.6459330143542,121.29186602870814 884,112 C 968.3540669856458,102.70813397129186 1029.244019138756,124.48803827751195 1118,136 C 1206.755980861244,147.51196172248805 1323.377990430622,148.75598086124404 1440,150 L 1440,600 L 0,600 Z"
      stroke="none"
      stroke-width="0"
      fill={`url(#${gradientId})`}
      fill-opacity="0.45"
      class="wave-path wave-path-0"
    ></path>

    <!-- Path 1: Lớp sóng trước (Opaque) -->
    <path
      d="M 0,600 L 0,350 C 130.18181818181816,319.11961722488036 260.3636363636363,288.2392344497608 337,279 C 413.6363636363637,269.7607655502392 436.72727272727286,282.1626794258373 523,319 C 609.2727272727271,355.8373205741627 758.7272727272727,417.11004784689 882,415 C 1005.2727272727273,412.88995215311 1102.3636363636365,347.39712918660285 1191,326 C 1279.6363636363635,304.60287081339715 1359.8181818181818,327.3014354066986 1440,350 L 1440,600 L 0,600 Z"
      stroke="none"
      stroke-width="0"
      fill={`url(#${gradientId})`}
      fill-opacity="0.9"
      class="wave-path wave-path-1"
    ></path>
  </svg>
</div>

<style>
  .hero-wave-container {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: clamp(50px, 7vw, 95px);
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
    z-index: 4;
  }

  .hero-wave-container svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wave-path {
    transition: all 0.3s ease-in-out;
  }

  /* Animated Mode (Homepage) */
  .hero-wave--animated .wave-path-0 {
    animation: pathAnim-0 4s linear infinite;
  }

  .hero-wave--animated .wave-path-1 {
    animation: pathAnim-1 4s linear infinite;
  }

  /* Static Mode (Insidepage) */
  .hero-wave--static .wave-path-0,
  .hero-wave--static .wave-path-1 {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave--animated .wave-path-0,
    .hero-wave--animated .wave-path-1 {
      animation: none !important;
    }
  }

