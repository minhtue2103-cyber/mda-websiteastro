---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  priority?: boolean;
}

const { src, alt, caption, priority = false } = Astro.props;
---

<figure class="feature-photo-wrapper">
  <div class="feature-photo-aspect">
    <img
      src={src}
      alt={alt}
      class="feature-photo"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      width="1200"
      height="675"
    />
  </div>
  {caption && (
    <figcaption class="feature-photo-caption">
      <i class="bi bi-camera"></i> {caption}
    </figcaption>
  )}
</figure>

<style>
  .feature-photo-wrapper {
    margin: 0 0 32px;
    padding: 0;
  }

  .feature-photo-aspect {
    aspect-ratio: 16 / 9;
    border-radius: var(--card-radius);
    overflow: hidden;
    background-color: var(--primary-50);
    box-shadow: var(--shadow-sm);
  }

  .feature-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .feature-photo-wrapper:hover .feature-photo {
    transform: scale(1.015);
  }

  .feature-photo-caption {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-top: 10px;
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 4px;
  }

  .feature-photo-caption i {
    color: var(--primary-dark);
  }
</style>
