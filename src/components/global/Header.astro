---
import SocialLinks from '../shared/SocialLinks.astro';
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <!-- Brand Logo -->
    <a href="/" class="site-logo" aria-label="Mekong Delta Agri Trang Chủ">
      <img
        src="/media/logoMDAgri500x500.svg"
        alt="Mekong Delta Agri Logo"
        width="48"
        height="48"
        class="site-logo__img"
      />
      <div class="site-logo__text">
        <span class="site-logo__title">MEKONG DELTA AGRI</span>
        <span class="site-logo__sub">MDA Agro-Export Knowledge Hub</span>
      </div>
    </a>

    <!-- Header Actions (Socials + Large Menu Toggle Button) -->
    <div class="header-actions">
      <div class="header-socials">
        <SocialLinks variant="header" />
      </div>

      <!-- Off-Canvas Toggle Button (Icon lớn, không text) -->
      <button
        id="open-drawer-btn"
        class="drawer-toggle-btn"
        aria-label="Mở menu điều hướng"
        title="Menu"
      >
        <i class="bi bi-list"></i>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    transition: box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .site-header.scrolled {
    box-shadow: var(--shadow-sm);
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 16px;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo__img {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(45, 94, 45, 0.12);
  }

  .site-logo__text {
    display: flex;
    flex-direction: column;
  }

  .site-logo__title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--primary-deep);
    line-height: 1.2;
    letter-spacing: 0.5px;
  }

  .site-logo__sub {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--secondary);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .header-socials {
      display: none;
    }
  }

  /* Drawer Toggle - Icon lớn, không chữ */
  .drawer-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--primary-50);
    border: 1.5px solid var(--primary-light);
    color: var(--primary-deep);
    border-radius: 10px;
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
  }

  .drawer-toggle-btn:hover {
    background-color: var(--primary-dark);
    color: #ffffff;
    border-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .drawer-toggle-btn i {
    font-size: 28px;
    line-height: 1;
  }
</style>

<script>
  function setupHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });
  }

  setupHeaderScroll();
  document.addEventListener('astro:page-load', setupHeaderScroll);
</script>
