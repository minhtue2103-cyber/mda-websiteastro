---
import { getCollection, type CollectionEntry } from 'astro:content';
import ChildDetailLayout from '../../layouts/ChildDetailLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: entry.data.category, url: '/blog/' },
  { name: entry.data.title, url: `/blog/${entry.slug}/` },
];
---

<ChildDetailLayout
  type="blog"
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  category={entry.data.category}
  author={entry.data.author}
  readingTime={entry.data.readingTime}
  headlinePhoto={entry.data.headlinePhoto}
  headlinePhotoAlt={entry.data.headlinePhotoAlt}
  headlinePhotoCaption={entry.data.headlinePhotoCaption}
  breadcrumbs={breadcrumbs}
  tags={entry.data.tags}
  faqSchema={entry.data.faqSchema}
  sources={entry.data.sources}
>
  <Content />
</ChildDetailLayout>
