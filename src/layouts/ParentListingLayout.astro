---
import BaseLayout from './BaseLayout.astro';
import AuthorGeoBox from '../components/shared/AuthorGeoBox.astro';
import ContactForm from '../components/shared/ContactForm.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  lead: string;
  badge?: string;
  breadcrumbs: BreadcrumbItem[];
  enableCategoryFilter?: boolean;
}

const {
  title,
  description,
  heroTitle,
  lead,
  badge = "MDA Knowledge Hub",
  breadcrumbs,
  enableCategoryFilter = false,
} = Astro.props;

const categories = [
  'Tất cả',
  'Chứng Từ & Pháp Lý XNK',
  'Đào Tạo XNK Thực Chiến',
  'Ứng Dụng AI Trong XNK',
  'AI Marketing Quốc Tế',
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": b.name,
    "item": new URL(b.url, Astro.site || 'https://mekongdeltaagri.com').href,
  })),
};
---

<BaseLayout title={title} description={description} schema={breadcrumbSchema}>
  <!-- Hero Section -->
  <section class="listing-hero section--soft">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span class="breadcrumb__separator">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="breadcrumb__current" aria-current="page">{b.name}</span>
            ) : (
              <a href={b.url}>{b.name}</a>
            )}
          </>
        ))}
      </nav>

      <div class="listing-hero__inner">
        <span class="badge">{badge}</span>
        <h1 class="page-hero__title">{heroTitle}</h1>
        <p class="lead page-hero__lead">{lead}</p>
      </div>

      {enableCategoryFilter && (
        <div class="category-filter-bar">
          <div class="category-buttons" id="categoryButtons">
            {categories.map((cat, i) => (
              <button
                type="button"
                class={`category-filter-btn ${i === 0 ? 'active' : ''}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>
          <div class="category-search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input
              type="text"
              id="instantSearchInput"
              placeholder="Tìm kiếm: Mã HS, FDA, BICON, AI Marketing..."
              aria-label="Tìm kiếm bài viết"
            />
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Listing Content Area -->
  <section class="section section--white">
    <div class="container">
      <slot />
    </div>
  </section>

  <!-- Author & Contact -->
  <div class="container">
    <AuthorGeoBox />
  </div>

  <section class="section section--soft">
    <div class="container" style="max-width: 820px;">
      <ContactForm
        title="Đăng Ký Nhận Bản Tin Pháp Lý &amp; Tư Vấn XNK"
        subtitle="Để lại email để nhận thông báo mới nhất về các thông tư hải quan và giải pháp tự động hóa bằng AI."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .listing-hero {
    padding-block: 40px 50px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .listing-hero__inner {
    max-width: 840px;
    margin-bottom: 24px;
  }

  /* Filter Bar */
  .category-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--border-subtle);
  }

  .category-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .category-filter-btn {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    padding: 8px 16px;
    border-radius: 20px;
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .category-filter-btn:hover,
  .category-filter-btn.active {
    background-color: var(--primary-dark);
    color: #ffffff;
    border-color: var(--primary-dark);
  }

  .category-search-wrapper {
    position: relative;
    min-width: 300px;
  }

  @media (max-width: 768px) {
    .category-search-wrapper {
      width: 100%;
    }
  }

  .category-search-wrapper input {
    width: 100%;
    padding: 8px 14px 8px 36px;
    font-family: inherit;
    font-size: 0.88rem;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    background: #ffffff;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    font-size: 14px;
  }
</style>

<script>
  function setupCategoryFiltering() {
    const buttons = document.querySelectorAll('.category-filter-btn');
    const searchInput = document.getElementById('instantSearchInput') as HTMLInputElement | null;
    const cards = document.querySelectorAll('[data-category]');

    if (!buttons.length && !searchInput) return;

    let selectedCat = 'Tất cả';
    let searchQuery = '';

    function applyFilter() {
      cards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category') || '';
        const text = el.innerText.toLowerCase();

        const matchCat = selectedCat === 'Tất cả' || cat === selectedCat;
        const matchSearch = !searchQuery || text.includes(searchQuery);

        if (matchCat && matchSearch) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        selectedCat = btn.getAttribute('data-category') || 'Tất cả';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilter();
      });
    }
  }

  setupCategoryFiltering();
  document.addEventListener('astro:page-load', setupCategoryFiltering);
</script>

