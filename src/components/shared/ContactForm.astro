---
interface Props {
  title?: string;
  subtitle?: string;
  extendedMode?: boolean;
}

const {
  title = "Kết Nối Cùng Chuyên Gia XNK & AI MDA",
  subtitle = "Điền thông tin bên dưới để nhận tư vấn lộ trình đào tạo thực chiến và giải đáp chứng từ hải quan trong vòng 24 giờ làm việc.",
  extendedMode = false,
} = Astro.props;
---

<div class="contact-form-wrapper" id="contact-form-block">
  <div class="form-header">
    <h3 class="form-title">{title}</h3>
    <p class="form-subtitle">{subtitle}</p>
  </div>

  <form class="mda-form" id="mdaLeadForm" novalidate>
    <div class="form-group">
      <label for="contact-name">Họ và tên <span class="required">*</span></label>
      <input type="text" id="contact-name" name="name" required placeholder="Ví dụ: Nguyễn Văn An" />
      <span class="field-error" id="nameError"></span>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="contact-phone">Số điện thoại / Zalo <span class="required">*</span></label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="Ví dụ: 0904 123 456"
          pattern="^(0|84)(3|5|7|8|9)[0-9]{8}$"
        />
        <span class="field-error" id="phoneError"></span>
      </div>

      <div class="form-group">
        <label for="contact-email">Email liên hệ <span class="required">*</span></label>
        <input type="email" id="contact-email" name="email" required placeholder="an.nguyen@company.com" />
        <span class="field-error" id="emailError"></span>
      </div>
    </div>

    <div class="form-group">
      <label for="contact-company">Tên Doanh nghiệp / Ngành hàng Nông sản</label>
      <input type="text" id="contact-company" name="company" placeholder="Ví dụ: Công ty Nông sản Xanh (Trái cây sấy/đông lạnh)" />
    </div>

    <div class="form-group">
      <label for="contact-service">Chương trình đào tạo &amp; Tư vấn quan tâm <span class="required">*</span></label>
      <select id="contact-service" name="service" required>
        <option value="" disabled selected>-- Chọn chương trình cần hỗ trợ --</option>
        <option value="dao-tao-xnk-1-1">Đào tạo XNK Thực chiến 1-1</option>
        <option value="dao-tao-chuyen-sau-doanh-nghiep">Đào tạo Chuyên sâu Doanh nghiệp (In-house)</option>
        <option value="ung-dung-ai-xnk">Ứng dụng AI cho Doanh nghiệp XNK</option>
        <option value="ai-marketing">AI Marketing cho Ngành Nông sản &amp; Xuất khẩu</option>
        <option value="tu-van-chung-tu-hs">Tư vấn Chứng từ, Mã HS &amp; Tuân thủ FDA/BICON/SPS</option>
      </select>
      <span class="field-error" id="serviceError"></span>
    </div>

    {extendedMode && (
      <div class="form-group">
        <label for="contact-timeslot">Khung giờ trải nghiệm học thử mong muốn</label>
        <select id="contact-timeslot" name="timeslot">
          <option value="morning">Buổi sáng (09:00 - 11:30 | Thứ 2 - Thứ 6)</option>
          <option value="afternoon">Buổi chiều (14:00 - 16:30 | Thứ 2 - Thứ 6)</option>
          <option value="weekend">Cuối tuần (Sáng Thứ 7)</option>
          <option value="online-flexible">Linh hoạt Online qua Google Meet / Zoom</option>
        </select>
      </div>
    )}

    <div class="form-group">
      <label for="contact-message">Nội dung vướng mắc hoặc nhu cầu tư vấn cụ thể</label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        placeholder="Chia sẻ về lô hàng dự kiến xuất khẩu, thị trường mục tiêu (Úc, Mỹ, Canada...), hoặc bài toán chứng từ/mã HS doanh nghiệp đang gặp phải..."
      ></textarea>
    </div>

    <button type="submit" class="btn btn-submit" id="submitBtn">
      <i class="bi bi-send-fill"></i>
      {extendedMode ? "Đăng Ký Học Thử Miễn Phí" : "Gửi Yêu Cầu Tư Vấn Ngay"}
    </button>

    <div class="form-feedback" id="formFeedback" role="alert" style="display: none;"></div>
  </form>
</div>

<style>
  .contact-form-wrapper {
    background: #ffffff;
    border-radius: var(--card-radius);
    padding: 32px;
    box-shadow: var(--shadow-md);
  }

  .form-title {
    font-size: 1.45rem;
    color: var(--primary-deep);
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .mda-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form-wrapper {
      padding: 20px;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #e53e3e;
  }

  input, select, textarea {
    width: 100%;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 0.95rem;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background-color: #fafdf8;
    color: var(--text-primary);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--primary-light);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(141, 196, 53, 0.2);
  }

  .field-error {
    font-size: 0.82rem;
    color: #e53e3e;
    min-height: 16px;
  }

  .btn-submit {
    background-color: var(--secondary);
    color: #ffffff;
    padding: 15px 30px;
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    transition: all var(--transition-base);
    box-shadow: 0 4px 14px rgba(255, 144, 70, 0.35);
    margin-top: 8px;
  }

  .btn-submit:hover {
    background-color: var(--secondary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 144, 70, 0.45);
  }

  .form-feedback {
    margin-top: 16px;
    padding: 14px 18px;
    border-radius: 8px;
    font-size: 0.95rem;
    text-align: center;
  }

  .form-feedback--success {
    background-color: #f0fff4;
    color: #276749;
    border: 1px solid #c6f6d5;
  }

  .form-feedback--error {
    background-color: #fff5f5;
    color: #9b2c2c;
    border: 1px solid #fed7d7;
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('mdaLeadForm') as HTMLFormElement | null;
    const feedback = document.getElementById('formFeedback') as HTMLDivElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

    if (!form || !feedback || !submitBtn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
      const service = (document.getElementById('contact-service') as HTMLSelectElement).value;

      let hasError = false;

      // Simple validation
      if (!name) {
        showError('nameError', 'Vui lòng nhập họ và tên của bạn.');
        hasError = true;
      } else {
        clearError('nameError');
      }

      const phoneRegex = /^(0|84)(3|5|7|8|9)[0-9]{8}$/;
      if (!phone || !phoneRegex.test(phone.replace(/\s+/g, ''))) {
        showError('phoneError', 'Vui lòng nhập số điện thoại hợp lệ tại Việt Nam (10 chữ số).');
        hasError = true;
      } else {
        clearError('phoneError');
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        showError('emailError', 'Vui lòng nhập địa chỉ email hợp lệ.');
        hasError = true;
      } else {
        clearError('emailError');
      }

      if (!service) {
        showError('serviceError', 'Vui lòng chọn chương trình bạn đang quan tâm.');
        hasError = true;
      } else {
        clearError('serviceError');
      }

      if (hasError) return;

      submitBtn.disabled = true;
      submitBtn.innerText = 'Đang gửi thông tin...';

      // Simulation / Fallback for Static Host
      setTimeout(() => {
        feedback.style.display = 'block';
        feedback.className = 'form-feedback form-feedback--success';
        feedback.innerHTML = `
          <strong>Đăng ký thành công!</strong><br />
          Cảm ơn anh/chị <strong>${name}</strong>. Chuyên gia tư vấn của MDA Hub sẽ chủ động liên hệ qua SĐT/Zalo <strong>${phone}</strong> trong vòng 24h.
        `;
        form.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-check2-circle"></i> Đã Gửi Thành Công';
      }, 700);
    });

    function showError(elementId: string, message: string) {
      const el = document.getElementById(elementId);
      if (el) el.innerText = message;
    }

    function clearError(elementId: string) {
      const el = document.getElementById(elementId);
      if (el) el.innerText = '';
    }
  }

  // Setup on page load
  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
