---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Thư Viện Nội Dung Đào Tạo Mẫu & Tài Liệu Thực Chiến MDA",
  subtitle = "Trải nghiệm trước khung chương trình đào tạo chuyên sâu và tải tài liệu tổng hợp biểu mẫu nghiệp vụ độc quyền từ MDA Hub.",
} = Astro.props;

const modules = [
  {
    code: "Module 01",
    tag: "Đào tạo XNK 1-1",
    title: "Bộ Checklist 12 Bước Kiểm Tra Chứng Từ Thương Mại",
    desc: "Quy trình kiểm soát rủi ro cho Invoice, Packing List, B/L, C/O và Phytosanitary chống tồn đọng và phạt chậm tại cảng đến.",
    icon: "bi-card-checklist",
    image: "https://picsum.photos/id/1018/600/420",
  },
  {
    code: "Module 02",
    tag: "Pháp Lý & Hải Quan",
    title: "Cẩm Nang Phân Loại Mã HS Nông Sản & Tối Ưu Thuế FTA",
    desc: "Giải mã Thông tư 85/2026/TT-BTC & 42/2026/TT-BCT, phân định trái cây tươi và nông sản sấy thăng hoa.",
    icon: "bi-file-earmark-ruled",
    image: "https://picsum.photos/id/1052/600/420",
  },
  {
    code: "Module 03",
    tag: "Tiêu Chuẩn Toàn Cầu",
    title: "Thực Hành Đăng Ký FDA, Tra Cứu BICON & Chuẩn SPS",
    desc: "Hướng dẫn từng bước tra cứu điều kiện nhập khẩu của Bộ Nông nghiệp Úc và thủ tục khai báo Prior Notice của FDA Mỹ.",
    icon: "bi-globe2",
    image: "https://picsum.photos/id/1067/600/420",
  },
  {
    code: "Module 04",
    tag: "Ứng Dụng AI XNK",
    title: "Bộ 25 Prompts AI Rà Soát Hợp Đồng & Chứng Từ Ngoại Thương",
    desc: "Bộ câu lệnh thực chiến giúp chuyên viên XNK rà soát mâu thuẫn điều khoản Incoterms và phát hiện sai số chỉ trong vài giây.",
    icon: "bi-cpu-fill",
    image: "https://picsum.photos/id/1070/600/420",
  },
  {
    code: "Module 05",
    tag: "AI Marketing & GEO",
    title: "Khung Chiến Lược Story Answering & Hiện Diện Số Chuẩn GEO",
    desc: "Xây dựng nội dung kỹ thuật để các công cụ AI (ChatGPT, Perplexity) chủ động trích dẫn doanh nghiệp với người mua quốc tế.",
    icon: "bi-graph-up-arrow",
    image: "https://picsum.photos/id/1080/600/420",
  },
  {
    code: "Module 06",
    tag: "Case Study Thực Tế",
    title: "Hồ Sơ Xuất Khẩu Trái Cây & Nông Sản Sấy Sang Úc, Canada",
    desc: "Bóc tách trọn vẹn bộ hồ sơ thực tế của một lô hàng mẫu thành công từ vùng trồng ĐBSCL đến bàn ăn người tiêu dùng quốc tế.",
    icon: "bi-folder-check",
    image: "https://picsum.photos/id/1062/600/420",
  },
];

// Double list for smooth infinite continuous auto-sliding marquee
const doubleModules = [...modules, ...modules];

const pdfUrl = "/media/mda-tai-lieu-dao-tao-mau-xnk-ai.pdf";
---

<section class="section section--white training-gallery-section" id="tai-lieu-dao-tao">
  <div class="container">
    <div class="section-header text-center">
      <span class="badge">Nghiệp Vụ &amp; Biểu Mẫu Thực Chiến</span>
      <h2 class="section-title shared-block__title">{title}</h2>
      <p class="lead">{subtitle}</p>
    </div>
  </div>

  <!-- Farm Table ft-services-way ft-bg-in Style: Photo Background & Infinite Auto-Moving Sliding Track -->
  <div class="gallery-slider-wrapper">
    <div class="gallery-marquee-container" id="galleryMarquee">
      <div class="gallery-marquee-track" id="marqueeTrack">
        {doubleModules.map((m, index) => (
          <div
            class="gallery-card gallery-card--bg"
            style={`background-image: url('${m.image}');`}
            data-index={index}
          >
            <div class="gallery-card__inner">
              <div class="gallery-card__top">
                <span class="module-tag">{m.tag}</span>
                <span class="gallery-card__icon-wrap">
                  <i class={`bi ${m.icon}`}></i>
                </span>
              </div>
              <h3 class="gallery-card__title">{m.title}</h3>
              <p class="gallery-card__desc">{m.desc}</p>
              <div class="gallery-card__action">
                <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="link-view-white">
                  Xem tóm tắt trong tài liệu &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container" style="margin-top: 56px;">
    <!-- Farm Table cat_bottom_sec ft-bg-in Style: Photo Background PDF Download Banner -->
    <div class="pdf-download-banner cat_bottom_sec ft-bg-in">
      <div class="cat-bottom-overlay"></div>
      <div class="pdf-banner-content">
        <div class="pdf-icon-wrapper">
          <i class="bi bi-file-earmark-pdf-fill"></i>
        </div>
        <div class="pdf-info">
          <span class="cat-bottom-pill">
            <i class="bi bi-download"></i> Tài Liệu Độc Quyền Miễn Phí
          </span>
          <h3 class="pdf-title">Tải Trọn Bộ Tài Liệu Đào Tạo Mẫu &amp; Biểu Mẫu Chứng Từ XNK (1 File PDF)</h3>
          <p class="pdf-desc">
            File PDF tổng hợp khung chương trình 6 Module chuyên sâu, sơ đồ quy trình kiểm tra chứng từ 12 bước và danh mục tra cứu nhanh mã HS nông sản nhiệt đới.
          </p>
        </div>
      </div>

      <div class="pdf-actions">
        <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline-light btn--lg">
          <i class="bi bi-eye-fill"></i> Xem Trực Tiếp
        </a>
        <a href={pdfUrl} download="mda-tai-lieu-dao-tao-mau-xnk-ai.pdf" class="btn btn--secondary btn--lg">
          <i class="bi bi-file-earmark-arrow-down-fill"></i> Tải Trọn Bộ (.PDF)
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .text-center {
    text-align: center;
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 40px;
  }

  .text-center .section-title {
    display: inline-block;
    margin-top: 10px;
  }

  /* =====================================================================
     FARM TABLE ft-services-way ft-bg-in STYLE: PHOTO BG & SLIDING AUTO MOVING
     ===================================================================== */
  .gallery-slider-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: 10px;
  }

  /* Fade masks on sides for elegant infinite look */
  .gallery-slider-wrapper::before,
  .gallery-slider-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(20px, 5vw, 80px);
    z-index: 5;
    pointer-events: none;
  }

  .gallery-slider-wrapper::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
  }

  .gallery-slider-wrapper::after {
    right: 0;
    background: linear-gradient(270deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
  }

  .gallery-marquee-container {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-marquee-container::-webkit-scrollbar {
    display: none;
  }

  .gallery-marquee-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marqueeSlide 40s linear infinite;
    padding-inline: 16px;
  }

  /* Pause auto-moving on hover so user can read / click */
  .gallery-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marqueeSlide {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Half of the doubled list */
      transform: translateX(-50%);
    }
  }

  /* Card with Photo Background (ft-bg-in) */
  .gallery-card--bg {
    position: relative;
    width: 360px;
    min-width: 340px;
    height: 400px;
    border-radius: var(--card-radius);
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    border: none;
    flex-shrink: 0;
  }

  .gallery-card--bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 45, 26, 0.35) 0%,
      rgba(14, 38, 22, 0.85) 60%,
      rgba(10, 26, 15, 0.96) 100%
    );
    transition: background var(--transition-base);
    z-index: 1;
  }

  .gallery-card--bg:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.2);
  }

  .gallery-card--bg:hover::before {
    background: linear-gradient(
      180deg,
      rgba(16, 45, 26, 0.2) 0%,
      rgba(14, 38, 22, 0.8) 55%,
      rgba(10, 26, 15, 0.98) 100%
    );
  }

  .gallery-card__inner {
    position: relative;
    z-index: 2;
    padding: 26px 24px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: flex-end;
  }

  .gallery-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: auto;
  }

  .module-tag {
    font-size: 0.78rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    padding: 4px 12px;
    border-radius: 14px;
    color: #ffffff;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .gallery-card__icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .gallery-card__title {
    font-size: 1.15rem;
    color: #ffffff;
    margin: 12px 0 8px;
    line-height: 1.4;
    font-family: var(--font-heading);
  }

  .gallery-card__desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.55;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .link-view-white {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--secondary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .link-view-white:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /* =====================================================================
     FARM TABLE cat_bottom_sec ft-bg-in STYLE: PHOTO BG PDF DOWNLOAD BANNER
     ===================================================================== */
  .cat_bottom_sec.ft-bg-in {
    position: relative;
    background-image: url('https://picsum.photos/id/1018/1200/500');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: var(--card-radius);
    padding: 44px 48px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    border: none;
  }

  .cat-bottom-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(24, 65, 42, 0.94) 0%,
      rgba(15, 38, 24, 0.96) 60%,
      rgba(10, 24, 15, 0.98) 100%
    );
    z-index: 1;
  }

  .pdf-banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .cat-bottom-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 144, 70, 0.22);
    border: 1px solid var(--secondary);
    color: #ffb885;
    padding: 4px 12px;
    border-radius: 14px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .pdf-icon-wrapper {
    font-size: 56px;
    color: #ffffff;
    line-height: 1;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    width: 88px;
    height: 88px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .pdf-info {
    max-width: 620px;
  }

  .pdf-title {
    font-size: 1.35rem;
    color: #ffffff;
    margin: 0 0 10px;
    line-height: 1.35;
  }

  .pdf-desc {
    font-size: 0.93rem;
    color: #e5f6c8;
    margin: 0;
    line-height: 1.6;
  }

  .pdf-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
    min-width: 210px;
  }

  .btn--outline-light {
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    color: #ffffff;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .btn--outline-light:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 960px) {
    .cat_bottom_sec.ft-bg-in {
      flex-direction: column;
      text-align: center;
      padding: 36px 24px;
      gap: 28px;
    }

    .pdf-banner-content {
      flex-direction: column;
    }

    .pdf-actions {
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .gallery-card--bg {
      width: 290px;
      min-width: 280px;
      height: 360px;
    }
  }
</style>
